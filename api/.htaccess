# VladSchool API — protezione e rewrite (shared hosting Apache)

Options -Indexes

# Blocca accesso diretto a .env e src/
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

<DirectoryMatch "src/.*">
    Order allow,deny
    Deny from all
</DirectoryMatch>

# install.php: accessibile ma consigliare di rimuovere dopo l'uso
<Files "install.php">
    Order allow,deny
    Allow from all
</Files>

# Rewrite: tutte le richieste a index.php (front controller)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /school/api/

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
