# VladSchool backend — .env (su FTP, MAI nel repository)
# Copia questo file in .env e compila i valori reali sul server.

# Database MySQL (shared hosting)
DB_HOST=localhost
DB_NAME=vladschool
DB_USER=utente_db
DB_PASS=password_db
DB_TABLE_PREFIX=vs_

# polza.ai (chiave solo lato server, mai nel browser)
POLZA_API_KEY=la_tua_chiave_polza
POLZA_BASE_URL=https://api.polza.ai/v1

# Admin panel
ADMIN_USER=admin
ADMIN_PASS_HASH=$2y$10$...  # genera con password_hash()

# Rate limit richieste/ora per utente
RATE_LIMIT_HOURLY=60

# Origine consentita per CORS (solo il tuo sito)
ALLOWED_ORIGIN=https://vladinc.ru/school
